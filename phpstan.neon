parameters:
    level: 6
    phpVersion: 80400
    bootstrapFiles:
        - phpstan-bootstrap.php
    fileExtensions:
        - php
    tmpDir: ./runtime/.phpstan/
    paths:
        - 'src'
        - 'benchmarks'
    excludePaths:
        - src/Backends/Amp.php
        - src/Backends/Swoole.php
    ignoreErrors:
        - identifier: foreach.emptyArray
    
