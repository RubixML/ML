includes:
    - phpstan-baseline.neon
parameters:
    level: 5
    phpVersion: 80400
    bootstrapFiles:
        - phpstan-bootstrap.php
    fileExtensions:
        - php
    tmpDir: ./runtime/.phpstan/
    paths:
        - 'src'
        - 'benchmarks'
    excludePaths:
        - src/Backends/Amp.php
        - src/Backends/Swoole.php
